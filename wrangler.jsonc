{
    "$schema": "node_modules/wrangler/config-schema.json",
    // NetTrailers as a Cloudflare Worker, built by OpenNext (see DEPLOY.md).
    // worker/index.ts wraps the generated .open-next/worker.js.
    "name": "net-trailers",
    "account_id": "b2c564cf83cb9184dd6d7cc4ff8b38bf",
    "main": "worker/index.ts",
    "compatibility_date": "2026-11-01",
    // nodejs_compat is required by OpenNext; global_fetch_strictly_public keeps
    // the server's own fetches (TMDB, Turso, Gemini) on the public internet.
    "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
    "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
    },
    // next/image (posters, backdrops, avatars, uploads) resizes through Cloudflare Images.
    "images": { "binding": "IMAGES" },
    // Workers Cache (worker/edgeCache.ts): Cloudflare's cache sits in front of the
    // CachedPages entrypoint, so the TMDB catalogue routes, optimized images and the
    // anonymous home page cost no CPU time once cached. The default entrypoint runs
    // on every request and sends only those there.
    "cache": { "enabled": false },
    "exports": {
        "default": { "type": "worker", "cache": { "enabled": false } },
        "CachedPages": { "type": "worker", "cache": { "enabled": true } },
    },
    "r2_buckets": [
        // ISR and the data cache (open-next.config.ts).
        { "binding": "NEXT_INC_CACHE_R2_BUCKET", "bucket_name": "net-trailers-opennext-cache" },
        // Uploaded images, which replaced Vercel Blob (lib/uploads.ts, worker/uploads.ts).
        { "binding": "UPLOADS", "bucket_name": "net-trailers-uploads" },
    ],
    "durable_objects": {
        "bindings": [{ "name": "NEXT_CACHE_DO_QUEUE", "class_name": "DOQueueHandler" }],
    },
    "migrations": [{ "tag": "v1", "new_sqlite_classes": ["DOQueueHandler"] }],
    // The revalidation queue, and the server's calls to its own API
    // (lib/selfFetch.ts), reach the Worker through this binding.
    "services": [{ "binding": "WORKER_SELF_REFERENCE", "service": "net-trailers" }],
    // Which version is live, for the AdminStats entrypoint (worker/adminStats.ts).
    "version_metadata": { "binding": "CF_VERSION_METADATA" },
    // Every email (sign-in links, digests, forum replies, admin email) goes
    // through Cloudflare Email Service from EMAIL_FROM on n8builds.dev, which
    // is onboarded for sending (no API key). The app's own caps are in
    // lib/email/gate.ts; the binding may send from this one address only.
    "send_email": [{ "name": "EMAIL", "allowed_sender_addresses": ["net-trailers@n8builds.dev"] }],
    // The three Vercel crons, same schedules (worker/crons.ts), 02:00 UTC on
    // Monday, Sunday and Wednesday. Weekdays are named because Cloudflare
    // counts them from 1 = Sunday, unlike Vercel's 0 = Sunday.
    "triggers": { "crons": ["0 2 * * MON", "0 2 * * SUN", "0 2 * * WED"] },
    "vars": {
        // Replaces VERCEL_ENV: "production" here; unset locally and in tests.
        "APP_ENV": "production",
        // The Vercel project is a redirect without crons, so the Worker alone
        // runs the three crons (worker/crons.ts).
        "CRONS_ENABLED": "true",
        // The site's one public address; the old nettrailers.n8builds.dev
        // forwards to it (worker/canonical.ts).
        "PUBLIC_URL": "https://net-trailers.n8builds.dev",
        // Admin accounts by sign-in email, comma-separated (lib/admin.ts).
        "ADMIN_EMAILS": "nathancwatkins23@gmail.com",
        // The sender for every email (lib/email/cloudflare.ts).
        "EMAIL_FROM": "net-trailers@n8builds.dev",
    },
    // Secrets (npx wrangler secret put <NAME>, see DEPLOY.md): TURSO_DATABASE_URL,
    // TURSO_AUTH_TOKEN, AUTH_SECRET, TMDB_API_KEY, GEMINI_API_KEY, CRON_SECRET,
    // TURNSTILE_SECRET_KEY.
    // Workers custom domains: Cloudflare creates and manages their DNS records and
    // certificates on deploy. net-trailers is the site; nettrailers is the old
    // address, kept so its links 301 to the new one (worker/canonical.ts).
    "routes": [
        { "pattern": "net-trailers.n8builds.dev", "custom_domain": true },
        { "pattern": "nettrailers.n8builds.dev", "custom_domain": true },
    ],
    "observability": { "enabled": true, "head_sampling_rate": 1 },
    "workers_dev": false,
    "preview_urls": false,
}
