# dependencies
/node_modules
/.pnp
.pnp.js

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.next-logs-enabled

# local env files
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.env.local
.env*.local

# Cloudflare (OpenNext build output, wrangler's local state and secrets)
/.open-next/
/.wrangler/
.dev.vars*

# End-to-end tests (Playwright)
/.e2e/
/test-results/
/playwright-report/

# Written by @sentry/nextjs during `next build` when a VERCEL variable is set
# (a leftover local Vercel link does that). The site runs on Cloudflare and
# never serves this route; untracked, it left the tree dirty and blocked releases.
/app/sentry-tunnel/
