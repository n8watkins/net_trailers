{
    "private": true,
    "scripts": {
        "dev": "node scripts/dev-safe.js",
        "dev:quiet": "SHOW_NEXT_LOGS=false node scripts/dev-safe.js",
        "dev:kill": "node scripts/kill-dev-servers.js",
        "dev:force": "node scripts/kill-dev-servers.js && node scripts/dev-safe.js",
        "dev:next": "CHOKIDAR_USEPOLLING=1 WATCHPACK_POLLING=true next dev -p 3000",
        "dev:turbo": "CHOKIDAR_USEPOLLING=1 WATCHPACK_POLLING=true next dev --turbo -p 3000",
        "build": "next build",
        "start": "next start",
        "build:worker": "opennextjs-cloudflare build",
        "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
        "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
        "check:deploy": "wrangler deploy --dry-run",
        "cf-typegen": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false cloudflare-env.d.ts && wrangler types --include-env=false worker/runtime.d.ts",
        "check:cf-types": "wrangler types --env-interface CloudflareEnv --strict-vars=false --include-runtime=false cloudflare-env.d.ts --check && wrangler types --include-env=false worker/runtime.d.ts --check",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "type-check": "tsc --noEmit && tsc --noEmit -p tsconfig.worker.json",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage --watchAll=false",
        "test:cron": "node scripts/test-cron.js",
        "test:cron:v2": "node scripts/test-cron-v2.js",
        "test:weekly-digest": "npx tsx scripts/test-weekly-digest.ts",
        "analyze": "ANALYZE=true npm run build",
        "db:generate": "drizzle-kit generate",
        "db:push": "drizzle-kit push",
        "db:migrate": "drizzle-kit migrate",
        "db:seed": "npx tsx scripts/seed.ts",
        "db:studio": "drizzle-kit studio",
        "prepare": "husky"
    },
    "dependencies": {
        "@auth/drizzle-adapter": "^1.11.2",
        "@babel/core": "7.29.13",
        "@dnd-kit/core": "^6.3.1",
        "@dnd-kit/sortable": "^10.0.0",
        "@dnd-kit/utilities": "^3.2.2",
        "@emotion/react": "^11.14.0",
        "@emotion/styled": "^11.14.1",
        "@google/generative-ai": "^0.24.1",
        "@heroicons/react": "^2.0.13",
        "@libsql/client": "^0.17.4",
        "@mui/material": "^5.11.7",
        "@next/third-parties": "^16.4.3",
        "@opennextjs/cloudflare": "1.20.15",
        "@react-email/components": "^1.0.1",
        "@sentry/nextjs": "^10.78.0",
        "@tiptap/extension-link": "^3.32.2",
        "@tiptap/extension-text-align": "^3.32.2",
        "@tiptap/extension-underline": "^3.32.2",
        "@tiptap/react": "^3.32.2",
        "@tiptap/starter-kit": "^3.32.2",
        "@types/bcryptjs": "^2.4.6",
        "bcryptjs": "^3.0.3",
        "browser-image-compression": "^2.0.2",
        "date-fns": "^4.1.0",
        "drizzle-orm": "^0.45.2",
        "lodash": "^4.17.21",
        "lucide-react": "^0.554.0",
        "nanoid": "^5.1.16",
        "next": "^16.4.3",
        "next-auth": "^5.0.0-beta.32",
        "react": "^19.2.0",
        "react-dom": "^19.2.0",
        "react-hook-form": "^7.43.0",
        "react-player": "^2.11.2",
        "resend": "^6.12.4",
        "sanitize-html": "^2.18.1",
        "uuid": "^13.0.0",
        "web-vitals": "^5.3.0",
        "zod": "^4.6.7",
        "zustand": "^5.0.8"
    },
    "devDependencies": {
        "@eslint/compat": "^1.4.0",
        "@eslint/js": "^9.38.0",
        "@next/bundle-analyzer": "^16.4.3",
        "@tailwindcss/postcss": "^4.3.0",
        "@testing-library/jest-dom": "^6.8.0",
        "@testing-library/react": "^16.3.0",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/node": "18.11.3",
        "@types/react": "^19.2.2",
        "@types/react-dom": "^19.2.2",
        "@types/sanitize-html": "^2.16.1",
        "@types/uuid": "^10.0.0",
        "autoprefixer": "^10.4.12",
        "baseline-browser-mapping": "^2.11.35",
        "dotenv": "^17.4.2",
        "drizzle-kit": "^0.31.10",
        "eslint": "^9.38.0",
        "eslint-config-next": "^16.4.3",
        "eslint-plugin-react": "^7.37.5",
        "eslint-plugin-react-hooks": "^7.0.1",
        "husky": "^9.1.7",
        "jest": "^30.1.3",
        "jest-environment-jsdom": "^30.1.2",
        "lint-staged": "^16.1.6",
        "node-mocks-http": "^1.17.2",
        "postcss": "^8.5.32",
        "prettier": "^3.6.2",
        "tailwind-scrollbar": "^4.0.2",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.46.2",
        "wrangler": "4.157.0"
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix",
            "prettier --write"
        ],
        "*.{json,md,css}": [
            "prettier --write"
        ]
    },
    "overrides": {
        "postcss": "$postcss",
        "glob": "^14.0.2",
        "@esbuild-kit/core-utils": {
            "esbuild": "^0.25.12"
        },
        "@typescript-eslint/typescript-estree": {
            "minimatch": "^11.0.1"
        },
        "test-exclude": {
            "minimatch": "^11.0.1"
        }
    }
}
